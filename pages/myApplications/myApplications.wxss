/* pages/myApplications/myApplications.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 状态标签 */
.status-tabs {
  margin: 20rpx;
  padding: 15rpx;
  display: flex;
  justify-content: space-around;
}

.tab-item {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  border-radius: 30rpx;
  background-color: #f5f5f5;
}

.tab-item.active {
  color: #ffffff;
  background-color: #4A90E2;
}

/* 申请列表 */
.application-list {
  padding: 0 20rpx;
}

.application-card {
  margin-bottom: 20rpx;
  padding: 25rpx;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.app-job {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.app-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.status-pending {
  background-color: #fffbe6;
  color: #faad14;
}

.status-approved {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.app-dept {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.app-info {
  display: flex;
  flex-direction: column;
  padding: 15rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-text {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-text:last-child {
  margin-bottom: 0;
}

.app-footer {
  margin-top: 15rpx;
}

.reject-reason {
  font-size: 24rpx;
  color: #ff4d4f;
}

.app-actions {
  margin-top: 15rpx;
  text-align: right;
}

.btn-view-salary {
  display: inline-block;
  padding: 10rpx 24rpx;
  background-color: #4A90E2;
  color: #ffffff;
  border-radius: 6rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  display: block;
  margin: 0 auto 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 30rpx;
}

.btn-go-apply {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
