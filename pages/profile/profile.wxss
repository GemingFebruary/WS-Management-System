/* pages/profile/profile.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  margin: 20rpx;
  padding: 30rpx;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #e8e8e8;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.user-detail {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.btn-login-action {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #4A90E2;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 30rpx;
}

/* 功能菜单 */
.menu-section {
  padding: 0 20rpx;
}

.menu-group {
  margin-bottom: 20rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

.admin-entry {
  background-color: #fff7e6;
}

.admin-entry .menu-text {
  color: #fa8c16;
  font-weight: bold;
}

/* 未登录提示 */
.login-tip {
  margin: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
}

.tip-text {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 10rpx;
}
