<!--pages/profile/editProfile/editProfile.wxml-->
<view class="container">
  <view class="card form-card">
    <view class="form-row">
      <form-input custom-class="half" label="姓名" value="{{form.name}}" field="name" placeholder="请输入姓名" bindinput="onField" />
      <view class="form-group half">
        <text class="form-label">性别</text>
        <picker data-field="gender" bindchange="onPicker" range="{{genderList}}">
          <view class="form-input">{{form.gender}} ▾</view>
        </picker>
      </view>
    </view>

    <view class="form-row">
      <form-input custom-class="half" label="学院" value="{{form.college}}" field="college" placeholder="请输入学院" bindinput="onField" />
      <form-input custom-class="half" label="专业" value="{{form.major}}" field="major" placeholder="请输入专业" bindinput="onField" />
    </view>

    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">年级</text>
        <picker data-field="grade" bindchange="onPicker" range="{{gradeList}}">
          <view class="form-input">{{form.grade || '请选择'}} ▾</view>
        </picker>
      </view>
      <form-input custom-class="half" label="GPA" value="{{form.gpa}}" field="gpa" type="digit" placeholder="0-4" bindinput="onField" />
    </view>

    <view class="form-row">
      <form-input custom-class="half" label="手机号" value="{{form.phone}}" field="phone" type="number" placeholder="请输入手机号" bindinput="onField" />
      <form-input custom-class="half" label="邮箱" value="{{form.email}}" field="email" placeholder="选填" bindinput="onField" />
    </view>

    <form-input label="空闲时间" value="{{form.freeTime}}" field="freeTime" placeholder="如：周二周四晚上、周末全天" bindinput="onField" />
    <form-input label="技能（顿号/逗号分隔）" value="{{form.skills}}" field="skills" placeholder="如：Office办公软件、Photoshop" bindinput="onField" />

    <view class="form-group">
      <text class="form-label">期望岗位类型</text>
      <checkbox-group bindchange="onJobTypeChange">
        <label class="checkbox-label"><checkbox value="校内" checked="{{form.preferredJobTypes.indexOf('校内') > -1}}" />校内</label>
        <label class="checkbox-label"><checkbox value="校外" checked="{{form.preferredJobTypes.indexOf('校外') > -1}}" />校外</label>
      </checkbox-group>
    </view>

    <form-input label="课程时间" value="{{form.courses}}" field="courses" placeholder="如：周一上午 高等数学" bindinput="onField" />

    <view class="form-group">
      <text class="form-label">家庭类型</text>
      <picker data-field="familyType" bindchange="onPicker" range="{{familyTypeList}}">
        <view class="form-input">{{form.familyType}} ▾</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">家庭情况</text>
      <textarea class="form-textarea" value="{{form.familyDesc}}" data-field="familyDesc" bindinput="onField" placeholder="选填，用于资助评定" />
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="save" disabled="{{saving}}">{{saving ? '保存中...' : '保存'}}</button>
  <view class="tip-text">带 * 的匹配画像（空闲时间、技能、期望岗位类型、课程）将用于智能匹配</view>
</view>
