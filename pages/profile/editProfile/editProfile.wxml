<!--pages/profile/editProfile/editProfile.wxml-->
<view class="container">
  <view class="card form-card">
    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">姓名</text>
        <input class="form-input" value="{{form.name}}" data-field="name" bindinput="onField" placeholder="请输入姓名" />
      </view>
      <view class="form-group half">
        <text class="form-label">性别</text>
        <picker data-field="gender" bindchange="onPicker" range="{{genderList}}">
          <view class="form-input">{{form.gender}} ▾</view>
        </picker>
      </view>
    </view>

    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">学院</text>
        <input class="form-input" value="{{form.college}}" data-field="college" bindinput="onField" placeholder="请输入学院" />
      </view>
      <view class="form-group half">
        <text class="form-label">专业</text>
        <input class="form-input" value="{{form.major}}" data-field="major" bindinput="onField" placeholder="请输入专业" />
      </view>
    </view>

    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">年级</text>
        <picker data-field="grade" bindchange="onPicker" range="{{gradeList}}">
          <view class="form-input">{{form.grade || '请选择'}} ▾</view>
        </picker>
      </view>
      <view class="form-group half">
        <text class="form-label">GPA</text>
        <input class="form-input" type="digit" value="{{form.gpa}}" data-field="gpa" bindinput="onField" placeholder="0-4" />
      </view>
    </view>

    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" value="{{form.phone}}" data-field="phone" bindinput="onField" placeholder="请输入手机号" />
      </view>
      <view class="form-group half">
        <text class="form-label">邮箱</text>
        <input class="form-input" value="{{form.email}}" data-field="email" bindinput="onField" placeholder="选填" />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">空闲时间</text>
      <input class="form-input" value="{{form.freeTime}}" data-field="freeTime" bindinput="onField" placeholder="如：周二周四晚上、周末全天" />
    </view>

    <view class="form-group">
      <text class="form-label">技能（顿号/逗号分隔）</text>
      <input class="form-input" value="{{form.skills}}" data-field="skills" bindinput="onField" placeholder="如：Office办公软件、Photoshop" />
    </view>

    <view class="form-group">
      <text class="form-label">期望岗位类型</text>
      <checkbox-group bindchange="onJobTypeChange">
        <label class="checkbox-label"><checkbox value="校内" checked="{{form.preferredJobTypes.indexOf('校内') > -1}}" />校内</label>
        <label class="checkbox-label"><checkbox value="校外" checked="{{form.preferredJobTypes.indexOf('校外') > -1}}" />校外</label>
      </checkbox-group>
    </view>

    <view class="form-group">
      <text class="form-label">课程时间</text>
      <input class="form-input" value="{{form.courses}}" data-field="courses" bindinput="onField" placeholder="如：周一上午 高等数学" />
    </view>

    <view class="form-group">
      <text class="form-label">家庭类型</text>
      <picker data-field="familyType" bindchange="onPicker" range="{{familyTypeList}}">
        <view class="form-input">{{form.familyType}} ▾</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">家庭情况</text>
      <textarea class="form-textarea" value="{{form.familyDesc}}" data-field="familyDesc" bindinput="onField" placeholder="选填，用于资助评定" />
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="save" disabled="{{saving}}">{{saving ? '保存中...' : '保存'}}</button>
  <view class="tip-text">带 * 的匹配画像（空闲时间、技能、期望岗位类型、课程）将用于智能匹配</view>
</view>
