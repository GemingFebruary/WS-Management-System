/* pages/login/login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90E2 0%, #f5f5f5 40%);
  padding: 80rpx 30rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.app-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 15rpx;
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-form {
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 28rpx;
  color: #333333;
}

.label-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.role-select {
  margin-top: 40rpx;
}

.role-options {
  display: flex;
  gap: 20rpx;
}

.role-option {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666666;
  border: 2rpx solid transparent;
}

.role-option.active {
  background-color: #e6f7ff;
  color: #4A90E2;
  border-color: #4A90E2;
}

.btn-login {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 40rpx;
  font-size: 32rpx;
}

.login-footer {
  text-align: center;
  margin-top: 30rpx;
}

.register-link {
  font-size: 26rpx;
  color: #4A90E2;
}
