/* pages/notices/notices.wxss */
.container { min-height: 100vh; background-color: #f5f5f5; padding: 20rpx; padding-bottom: 120rpx; }

.notice-list { }
.notice-card { margin-bottom: 16rpx; padding: 25rpx; }
.notice-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10rpx; }
.notice-title { font-size: 30rpx; font-weight: bold; color: #333; flex: 1; }
.notice-date { font-size: 22rpx; color: #999; white-space: nowrap; margin-left: 12rpx; }
.notice-preview { font-size: 26rpx; color: #666; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 8rpx; }
.notice-publisher { font-size: 22rpx; color: #999; display: block; }

.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { width: 80rpx; height: 80rpx; display: block; margin: 0 auto 15rpx; }
.empty-text { font-size: 26rpx; color: #999; }
