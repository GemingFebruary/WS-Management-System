<!--pages/notices/notices.wxml-->
<view class="container">
  <view class="notice-list">
    <block wx:for="{{noticeList}}" wx:key="_id">
      <view class="notice-card card" bindtap="openDetail" data-idx="{{index}}">
        <view class="notice-top">
          <text class="notice-title">{{item.title}}</text>
          <text class="notice-date">{{item.date}}</text>
        </view>
        <text class="notice-preview">{{item.content}}</text>
        <text class="notice-publisher" wx:if="{{item.publisher}}">发布者: {{item.publisher}}</text>
      </view>
    </block>
    <empty-state show="{{noticeList.length === 0 && !loading}}" text="暂无公告" />
  </view>
</view>
