/* pages/applyJob/applyJob.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 岗位摘要 */
.job-summary {
  margin: 20rpx;
  padding: 25rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: #ffffff;
}

.summary-title {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.summary-content {
  display: flex;
  flex-direction: column;
}

.job-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.job-dept {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 5rpx;
}

.job-salary {
  font-size: 28rpx;
  font-weight: bold;
}

/* 申请表单 */
.apply-form {
  margin: 20rpx;
  padding: 25rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input[disabled] {
  background-color: #f0f0f0;
  color: #999999;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 15rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 8rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  background-color: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
}

.file-list {
  margin-top: 15rpx;
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.file-name {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-remove {
  font-size: 36rpx;
  color: #ff4d4f;
  padding: 0 10rpx;
}

/* 提交区域 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

.submit-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}
