/* pages/admin/optionManage/optionManage.wxss */
.card { padding: 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 20rpx; }
.tag-list { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; }
.tag { display: inline-flex; align-items: center; background: var(--color-primary-light); border-radius: 24rpx; padding: 10rpx 20rpx; margin: 0 16rpx 16rpx 0; }
.tag-text { font-size: 26rpx; color: var(--color-primary-dark); }
.tag-del { font-size: 24rpx; color: var(--color-text-hint); margin-left: 12rpx; }
.add-row { display: flex; align-items: center; }
.add-row .form-input { flex: 1; margin-right: 16rpx; }
.btn-add { background: var(--color-primary); color: #fff; font-size: 26rpx; padding: 0 28rpx; height: 76rpx; line-height: 76rpx; border-radius: var(--radius-sm); }
.picker-current { height: 76rpx; line-height: 76rpx; padding: 0 20rpx; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 28rpx; color: var(--color-text); }
.save-btn { margin: 16rpx 24rpx; }
