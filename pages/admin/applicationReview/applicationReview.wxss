/* pages/admin/applicationReview/applicationReview.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 筛选栏 */
.filter-bar {
  margin: 20rpx;
  padding: 15rpx;
  display: flex;
  justify-content: space-around;
}

.filter-item {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  border-radius: 30rpx;
  background-color: #f5f5f5;
}

.filter-item.active {
  color: #ffffff;
  background-color: #4A90E2;
}

/* 申请列表 */
.application-list {
  padding: 0 20rpx;
}

.application-card {
  margin-bottom: 20rpx;
  padding: 25rpx;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-info {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.student-id {
  font-size: 22rpx;
  color: #999999;
}

.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.status-pending {
  background-color: #fffbe6;
  color: #faad14;
}

.status-approved {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.app-job {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.app-details {
  display: flex;
  flex-direction: column;
  padding: 15rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-text {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.app-reason {
  margin-top: 15rpx;
  padding: 15rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}

.reason-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 5rpx;
}

.reason-content {
  font-size: 26rpx;
  color: #333333;
}

.app-actions {
  margin-top: 15rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.btn-approve, .btn-reject {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 6rpx;
}

.btn-approve {
  background-color: #52c41a;
  color: #ffffff;
}

.btn-reject {
  background-color: #ff4d4f;
  color: #ffffff;
}

.review-info {
  font-size: 22rpx;
  color: #999999;
  width: 100%;
}

.reject-reason {
  font-size: 24rpx;
  color: #ff4d4f;
  width: 100%;
  margin-top: 10rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 15rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}
