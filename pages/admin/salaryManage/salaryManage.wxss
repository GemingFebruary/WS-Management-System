/* pages/admin/salaryManage/salaryManage.wxss */
.container { padding: 12rpx; box-sizing: border-box; overflow-x: hidden; }

.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }

/* 筛选区域 */
.filter-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.picker-btn { flex: 1; padding: 16rpx 20rpx; background: #f8f8f8; border-radius: 8rpx; font-size: 26rpx; color: #333; text-align: center; }
.search-row { display: flex; gap: 12rpx; }
.search-input { flex: 1; padding: 16rpx 20rpx; background: #f8f8f8; border-radius: 8rpx; font-size: 26rpx; min-width: 0; }
.btn-search { padding: 16rpx 32rpx; background: #4A90E2; color: #fff; border: none; border-radius: 8rpx; font-size: 26rpx; white-space: nowrap; }
.filter-actions { display: flex; gap: 12rpx; flex-wrap: wrap; }
.btn-primary { padding: 16rpx 24rpx; background: #4A90E2; color: #fff; border: none; border-radius: 8rpx; font-size: 26rpx; }
.btn-success { padding: 16rpx 24rpx; background: #52c41a; color: #fff; border: none; border-radius: 8rpx; font-size: 26rpx; }
.btn-warning { padding: 16rpx 24rpx; background: #faad14; color: #fff; border: none; border-radius: 8rpx; font-size: 26rpx; }
.btn-danger { padding: 16rpx 24rpx; background: #ff4d4f; color: #fff; border: none; border-radius: 8rpx; font-size: 26rpx; }
.btn-cancel { padding: 16rpx 24rpx; background: #f5f5f5; color: #666; border: 2rpx solid #ddd; border-radius: 8rpx; font-size: 26rpx; }

/* 汇总卡片 */
.summary-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; display: block; }
.summary-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.summary-item { flex: 1; min-width: 120rpx; text-align: center; padding: 16rpx 8rpx; background: #f8fafc; border-radius: 8rpx; }
.summary-item.paid .summary-value { color: #52c41a; }
.summary-item.unpaid .summary-value { color: #faad14; }
.summary-value { display: block; font-size: 32rpx; font-weight: 700; color: #333; }
.summary-label { display: block; font-size: 20rpx; color: #999; margin-top: 4rpx; }

/* 列表 */
.list-header { margin-bottom: 16rpx; }
.list-count { font-size: 24rpx; color: #999; }

.loading-state { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0; color: #999; font-size: 26rpx; }
.spinner { width: 48rpx; height: 48rpx; border: 4rpx solid #eee; border-top-color: #4A90E2; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 12rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0; color: #999; font-size: 26rpx; }
.empty-icon { width: 80rpx; height: 80rpx; opacity: 0.3; margin-bottom: 12rpx; }

.select-all-row { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.select-all-text { font-size: 24rpx; color: #666; }

/* 薪资记录项 */
.salary-item { padding: 20rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.item-top { display: flex; align-items: center; gap: 12rpx; }
.item-info { flex: 1; min-width: 0; }
.item-student { font-size: 28rpx; font-weight: 600; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-job { font-size: 22rpx; color: #999; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-amount { text-align: right; flex-shrink: 0; }
.amount-value { font-size: 30rpx; font-weight: 700; color: #333; display: block; }
.status-tag { display: inline-block; padding: 4rpx 12rpx; border-radius: 16rpx; font-size: 20rpx; margin-top: 4rpx; }
.status-tag.paid { background: #f6ffed; color: #52c41a; }
.status-tag.unpaid { background: #fffbe6; color: #faad14; }

.item-detail { padding: 8rpx 0 4rpx; }
.detail-text { font-size: 24rpx; color: #999; }

.item-actions { display: flex; gap: 16rpx; margin-top: 12rpx; flex-wrap: wrap; }
.btn-link { background: none; border: none; font-size: 24rpx; padding: 4rpx 8rpx; text-decoration: underline; line-height: 1; min-height: auto; }
.btn-link.edit { color: #4A90E2; }
.btn-link.delete { color: #ff4d4f; }
.btn-link.pay { color: #52c41a; }

.pagination { display: flex; justify-content: center; align-items: center; gap: 20rpx; margin-top: 24rpx; padding-top: 16rpx; border-top: 2rpx solid #f0f0f0; }
.page-btn { padding: 8rpx 24rpx; background: #fff; border: 2rpx solid #ddd; border-radius: 8rpx; font-size: 24rpx; }
.page-btn[disabled] { opacity: 0.4; }
.page-info { font-size: 24rpx; color: #666; }

/* 弹窗 */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-box { width: 90%; max-height: 80vh; background: #fff; border-radius: 16rpx; display: flex; flex-direction: column; overflow: hidden; }
.modal-box.small { max-height: 50vh; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 2rpx solid #f0f0f0; flex-shrink: 0; }
.modal-title { font-size: 30rpx; font-weight: 600; color: #333; }
.modal-close { font-size: 40rpx; color: #999; padding: 0 8rpx; }
.modal-body { flex: 1; padding: 24rpx; overflow-y: auto; }
.modal-footer { display: flex; gap: 16rpx; padding: 20rpx 24rpx; border-top: 2rpx solid #f0f0f0; flex-shrink: 0; }
.modal-footer button { flex: 1; }

.form-group { margin-bottom: 20rpx; }
.form-group.half { flex: 1; }
.form-row { display: flex; gap: 16rpx; }
.form-label { font-size: 24rpx; color: #666; margin-bottom: 8rpx; display: block; }
.form-input { width: 100%; padding: 16rpx 20rpx; background: #f8f8f8; border-radius: 8rpx; font-size: 26rpx; box-sizing: border-box; min-width: 0; }
.picker-value { line-height: 1.6; }

.confirm-text { font-size: 28rpx; color: #333; line-height: 1.8; white-space: pre-wrap; }
