<!--pages/admin/admin.wxml-->
<view class="container">
  <!-- 管理员信息 -->
  <view class="admin-header card">
    <view class="header-content">
      <text class="admin-title">管理后台</text>
      <text class="admin-name">{{adminInfo.name}}</text>
      <text class="admin-role">管理员</text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-section">
    <view class="stat-card card" bindtap="goToJobManage">
      <image class="stat-icon" src="/images/icon/document.png" mode="aspectFit"></image>
      <view class="stat-info">
        <text class="stat-value">{{stats.jobCount}}</text>
        <text class="stat-label">岗位总数</text>
      </view>
    </view>
    <view class="stat-card card" bindtap="goToApplicationReview">
      <image class="stat-icon" src="/images/icon/edit-pen.png" mode="aspectFit"></image>
      <view class="stat-info">
        <text class="stat-value pending">{{stats.pendingCount}}</text>
        <text class="stat-label">待审核申请</text>
      </view>
    </view>
    <view class="stat-card card">
      <image class="stat-icon" src="/images/icon/user.png" mode="aspectFit"></image>
      <view class="stat-info">
        <text class="stat-value">{{stats.studentCount}}</text>
        <text class="stat-label">学生总数</text>
      </view>
    </view>
    <view class="stat-card card">
      <image class="stat-icon" src="/images/icon/money.png" mode="aspectFit"></image>
      <view class="stat-info">
        <text class="stat-value">¥{{stats.totalSalary}}</text>
        <text class="stat-label">本月发放</text>
      </view>
    </view>
  </view>

  <!-- 公告管理 -->
  <view class="menu-section" style="margin-top: 0;">
    <view class="menu-group card">
      <view class="menu-title">公告管理</view>
      <view class="menu-item" bindtap="goToNoticeManage">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/document.png" mode="aspectFit"></image>
          <text class="menu-text">公告管理</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToPublishNotice">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/plus.png" mode="aspectFit"></image>
          <text class="menu-text">发布公告</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group card">
      <view class="menu-title">岗位管理</view>
      <view class="menu-item" bindtap="goToJobManage">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/document.png" mode="aspectFit"></image>
          <text class="menu-text">岗位管理</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="addJob">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/plus.png" mode="aspectFit"></image>
          <text class="menu-text">发布新岗位</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-group card">
      <view class="menu-title">申请管理</view>
      <view class="menu-item" bindtap="goToApplicationReview">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/check.png" mode="aspectFit"></image>
          <text class="menu-text">申请审核</text>
          <text class="menu-badge" wx:if="{{stats.pendingCount > 0}}">{{stats.pendingCount}}</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="viewAllApplications">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/document.png" mode="aspectFit"></image>
          <text class="menu-text">全部申请</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-group card">
      <view class="menu-title">薪资管理</view>
      <view class="menu-item" bindtap="salaryManage">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/money.png" mode="aspectFit"></image>
          <text class="menu-text">薪资录入</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="salaryStats">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/data-line.png" mode="aspectFit"></image>
          <text class="menu-text">薪资统计</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-group card">
      <view class="menu-title">系统管理</view>
      <view class="menu-item" bindtap="studentManage">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/user.png" mode="aspectFit"></image>
          <text class="menu-text">学生管理</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="dataExport">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/download.png" mode="aspectFit"></image>
          <text class="menu-text">数据导出</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="systemSettings">
        <view class="menu-left">
          <image class="menu-icon" src="/images/icon/setting.png" mode="aspectFit"></image>
          <text class="menu-text">系统设置</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
