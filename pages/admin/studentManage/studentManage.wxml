<!--pages/admin/studentManage/studentManage.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar card">
    <view class="search-row">
      <input class="search-input" placeholder="搜索姓名/学号/学院" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" />
      <button class="btn-search" bindtap="doSearch">搜索</button>
    </view>
    <text class="total-text">共 {{studentList.length}} 名学生</text>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <block wx:for="{{studentList}}" wx:key="userId">
      <view class="student-card card">
        <view class="s-header">
          <view class="s-info">
            <text class="s-name">{{item.name}}</text>
            <text class="s-status {{item.status}}">{{item.status === 'active' ? '正常' : '已禁用'}}</text>
          </view>
          <text class="s-id">{{item.studentId}}</text>
        </view>
        <view class="s-meta">
          <text>{{item.college}} · {{item.major}}</text>
          <text>{{item.grade}} {{item.gpa ? '· GPA ' + item.gpa : ''}}</text>
        </view>
        <view class="s-contact" wx:if="{{item.phone || item.email}}">
          <text wx:if="{{item.phone}}">{{item.phone}}</text>
          <text wx:if="{{item.email}}">{{item.email}}</text>
        </view>
        <view class="s-actions">
          <button class="btn-action btn-edit" bindtap="openEdit" data-id="{{item.userId}}">编辑</button>
          <button class="btn-action btn-reset" bindtap="resetPassword" data-id="{{item.userId}}">重置密码</button>
          <button class="btn-action {{item.status === 'active' ? 'btn-disable' : 'btn-enable'}}" bindtap="toggleStatus" data-id="{{item.userId}}">
            {{item.status === 'active' ? '禁用' : '启用'}}
          </button>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:if="{{studentList.length === 0 && !loading}}">
      <image class="empty-icon" src="/images/icon/empty-box.png" mode="aspectFit"></image>
      <text class="empty-text">暂无学生数据</text>
    </view>
  </view>

  <!-- 分页 -->
  <pagination current="{{pageNum}}" pageSize="{{pageSize}}" total="{{total}}" bindchange="onPageChange" />

</view>
<toast id="globalToast" />
