/* pages/admin/jobManage/jobManage.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

.action-bar {
  margin: 20rpx;
  padding: 20rpx;
}

.btn-add {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}

.job-list {
  padding: 0 20rpx;
}

.job-card {
  margin-bottom: 20rpx;
  padding: 25rpx;
}

.job-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.job-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.status-recruiting {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-closed {
  background-color: #f5f5f5;
  color: #999999;
}

.job-info {
  display: flex;
  flex-direction: column;
  padding: 15rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.job-info text {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.job-actions {
  display: flex;
  gap: 15rpx;
  margin-top: 15rpx;
}

.btn-action {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  border-radius: 6rpx;
}

.btn-edit {
  background-color: #e6f7ff;
  color: #4A90E2;
}

.btn-toggle {
  background-color: #fffbe6;
  color: #faad14;
}

.btn-delete {
  background-color: #fff2f0;
  color: #ff4d4f;
}
