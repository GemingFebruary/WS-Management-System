/* pages/admin/jobManage/jobManage.wxss */
.container { min-height: 100vh; background-color: #f5f5f5; padding-bottom: 20rpx; box-sizing: border-box; overflow-x: hidden; }

/* 搜索+筛选栏 */
.action-bar { margin: 20rpx; padding: 20rpx; box-sizing: border-box; }
.search-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 20rpx; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 28rpx; background: #fff; box-sizing: border-box; }
.btn-search { height: 72rpx; line-height: 72rpx; padding: 0 24rpx; background: #4A90E2; color: #fff; font-size: 28rpx; border-radius: 8rpx; white-space: nowrap; flex-shrink: 0; }
.filter-row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.filter-picker { padding: 8rpx 20rpx; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 26rpx; background: #fff; white-space: nowrap; }
.total-text { font-size: 24rpx; color: #999; flex: 1; text-align: right; min-width: 0; }
.btn-add { height: 60rpx; line-height: 60rpx; padding: 0 24rpx; background: #52c41a; color: #fff; font-size: 26rpx; border-radius: 8rpx; white-space: nowrap; flex-shrink: 0; }

/* 岗位列表 */
.job-list { padding: 0 20rpx; box-sizing: border-box; }
.job-card { margin-bottom: 20rpx; padding: 25rpx; box-sizing: border-box; overflow: hidden; }
.job-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; gap: 12rpx; }
.job-name { font-size: 30rpx; font-weight: bold; color: #333; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status-tag { padding: 4rpx 12rpx; border-radius: 4rpx; font-size: 22rpx; white-space: nowrap; flex-shrink: 0; }
.status-recruiting { background: #f6ffed; color: #52c41a; }
.status-full { background: #fff2f0; color: #ff4d4f; }
.status-closed { background: #f5f5f5; color: #999; }
.job-info { display: flex; flex-direction: column; padding: 12rpx 0; border-top: 1rpx solid #f5f5f5; border-bottom: 1rpx solid #f5f5f5; }
.job-info text { font-size: 26rpx; color: #666; margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.job-actions { display: flex; gap: 12rpx; margin-top: 15rpx; flex-wrap: wrap; }
.btn-action { height: 60rpx; line-height: 60rpx; font-size: 24rpx; border-radius: 6rpx; text-align: center; padding: 0 16rpx; white-space: nowrap; }
.btn-edit { background: #e6f7ff; color: #4A90E2; }
.btn-status { background: #fffbe6; color: #faad14; }
.btn-delete { background: #fff2f0; color: #ff4d4f; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-box { width: 92%; max-height: 85vh; background: #fff; border-radius: 16rpx; display: flex; flex-direction: column; overflow: hidden; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; flex-shrink: 0; }
.modal-title { font-size: 32rpx; font-weight: bold; }
.modal-close { font-size: 36rpx; color: #999; padding: 0 10rpx; }
.modal-body { padding: 20rpx 30rpx; overflow-y: auto; flex: 1; }
.modal-footer { display: flex; justify-content: flex-end; gap: 16rpx; padding: 20rpx 30rpx; border-top: 1rpx solid #f0f0f0; flex-shrink: 0; }
.btn-cancel { flex: 1; height: 72rpx; line-height: 72rpx; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 28rpx; background: #fff; }
.btn-confirm { flex: 1; height: 72rpx; line-height: 72rpx; background: #4A90E2; color: #fff; border-radius: 8rpx; font-size: 28rpx; }

/* 表单 */
.form-group { margin-bottom: 20rpx; }
.form-label { font-size: 24rpx; color: #666; margin-bottom: 8rpx; display: block; }
.form-input { height: 72rpx; padding: 0 20rpx; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 28rpx; background: #fff; line-height: 72rpx; box-sizing: border-box; overflow: hidden; text-overflow: ellipsis; }
.form-textarea { width: 100%; min-height: 120rpx; padding: 16rpx 20rpx; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 28rpx; background: #fff; box-sizing: border-box; }
.form-row { display: flex; gap: 16rpx; }
.form-group.half { flex: 1; min-width: 0; }

/* 空状态 */
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { width: 80rpx; height: 80rpx; display: block; margin: 0 auto 15rpx; }
.empty-text { font-size: 26rpx; color: #999; }
