<!--pages/admin/jobManage/jobManage.wxml-->
<view class="container">
  <!-- 搜索+筛选栏 -->
  <view class="action-bar card">
    <view class="search-row">
      <input class="search-input" placeholder="搜索岗位名称/部门" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" />
      <button class="btn-search" bindtap="doSearch">搜索</button>
    </view>
    <view class="filter-row">
      <picker bindchange="onStatusFilterChange" value="{{statusFilterIndex}}" range="{{statusOptions}}" range-key="label">
        <view class="filter-picker">{{statusOptions[statusFilterIndex].label}} ▾</view>
      </picker>
      <text class="total-text">共 {{jobList.length}} 个岗位</text>
      <button class="btn-add" bindtap="openCreate">+ 发布</button>
    </view>
  </view>

  <!-- 岗位列表 -->
  <view class="job-list">
    <block wx:for="{{jobList}}" wx:key="jobId">
      <view class="job-card card">
        <view class="job-header">
          <text class="job-name">{{item.jobName}}</text>
          <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="job-info">
          <text>{{item.department}} · {{item.jobType}}</text>
          <text>招聘 {{item.recruitNum}} 人 · ¥{{item.salary}}/时</text>
          <text wx:if="{{item.workTime}}">时间: {{item.workTime}}</text>
        </view>
        <view class="job-actions">
          <button class="btn-action btn-edit" bindtap="openEdit" data-id="{{item.jobId}}">编辑</button>
          <picker bindchange="changeStatus" data-id="{{item.jobId}}" value="0" range="{{['招聘中','已满员','已关闭']}}">
            <button class="btn-action btn-status">状态 ▾</button>
          </picker>
          <button class="btn-action btn-delete" bindtap="deleteJob" data-id="{{item.jobId}}">删除</button>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:if="{{jobList.length === 0 && !loading}}">
      <image class="empty-icon" src="/images/icon/empty-box.png" mode="aspectFit"></image>
      <text class="empty-text">暂无岗位</text>
    </view>
  </view>

</view>
<toast id="globalToast" />
