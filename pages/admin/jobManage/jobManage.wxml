<!--pages/admin/jobManage/jobManage.wxml-->
<view class="container">
  <!-- 搜索+筛选栏 -->
  <view class="action-bar card">
    <view class="search-row">
      <input class="search-input" placeholder="搜索岗位名称/部门" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" />
      <button class="btn-search" bindtap="doSearch">搜索</button>
    </view>
    <view class="filter-row">
      <picker bindchange="onStatusFilterChange" value="{{statusFilterIndex}}" range="{{statusOptions}}" range-key="label">
        <view class="filter-picker">{{statusOptions[statusFilterIndex].label}} ▾</view>
      </picker>
      <text class="total-text">共 {{jobList.length}} 个岗位</text>
      <button class="btn-add" bindtap="openCreate">+ 发布</button>
    </view>
  </view>

  <!-- 岗位列表 -->
  <view class="job-list">
    <block wx:for="{{jobList}}" wx:key="jobId">
      <view class="job-card card">
        <view class="job-header">
          <text class="job-name">{{item.jobName}}</text>
          <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="job-info">
          <text>{{item.department}} · {{item.jobType}}</text>
          <text>招聘 {{item.recruitNum}} 人 · ¥{{item.salary}}/时</text>
          <text wx:if="{{item.workTime}}">时间: {{item.workTime}}</text>
        </view>
        <view class="job-actions">
          <button class="btn-action btn-edit" bindtap="openEdit" data-id="{{item.jobId}}">编辑</button>
          <picker bindchange="changeStatus" data-id="{{item.jobId}}" value="0" range="{{['招聘中','已满员','已关闭']}}">
            <button class="btn-action btn-status">状态 ▾</button>
          </picker>
          <button class="btn-action btn-delete" bindtap="deleteJob" data-id="{{item.jobId}}">删除</button>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:if="{{jobList.length === 0 && !loading}}">
      <image class="empty-icon" src="/images/icon/empty-box.png" mode="aspectFit"></image>
      <text class="empty-text">暂无岗位</text>
    </view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal">
    <view class="modal-box" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{isEdit ? '编辑岗位' : '发布新岗位'}}</text>
        <text class="modal-close" bindtap="closeEditModal">✕</text>
      </view>
      <scroll-view class="modal-body" scroll-y>
        <view class="form-group">
          <text class="form-label">岗位名称 *</text>
          <input class="form-input" value="{{jobForm.jobName}}" data-field="jobName" bindinput="onFormField" placeholder="如：图书馆助理" />
        </view>
        <view class="form-group">
          <text class="form-label">所属部门 *</text>
          <input class="form-input" value="{{jobForm.department}}" data-field="department" bindinput="onFormField" placeholder="如：图书馆" />
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">岗位类型</text>
            <picker data-field="jobType" bindchange="onFormField" value="0" range="{{['校内','校外']}}">
              <view class="form-input">{{jobForm.jobType}} ▾</view>
            </picker>
          </view>
          <view class="form-group half">
            <text class="form-label">招聘人数</text>
            <input class="form-input" type="number" value="{{jobForm.recruitNum}}" data-field="recruitNum" bindinput="onFormNumberField" />
          </view>
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">薪资（元/时）</text>
            <input class="form-input" type="digit" value="{{jobForm.salary}}" data-field="salary" bindinput="onFormNumberField" />
          </view>
          <view class="form-group half">
            <text class="form-label">工作时间</text>
            <input class="form-input" value="{{jobForm.workTime}}" data-field="workTime" bindinput="onFormField" placeholder="如：周一至周五 14:00-17:00" />
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">岗位要求</text>
          <textarea class="form-textarea" value="{{jobForm.requirement}}" data-field="requirement" bindinput="onFormField" placeholder="填写岗位要求" />
        </view>
        <view class="form-group">
          <text class="form-label">工作内容</text>
          <textarea class="form-textarea" value="{{jobForm.jobContent}}" data-field="jobContent" bindinput="onFormField" placeholder="填写工作内容" />
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">专业要求</text>
            <input class="form-input" value="{{jobForm.requiredMajor}}" data-field="requiredMajor" bindinput="onFormField" placeholder="不限留空" />
          </view>
          <view class="form-group half">
            <text class="form-label">年级要求</text>
            <input class="form-input" value="{{jobForm.requiredGrade}}" data-field="requiredGrade" bindinput="onFormField" placeholder="不限留空" />
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">最低GPA</text>
          <input class="form-input" type="digit" value="{{jobForm.minGpa}}" data-field="minGpa" bindinput="onFormNumberField" />
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">联系人</text>
            <input class="form-input" value="{{jobForm.contactPerson}}" data-field="contactPerson" bindinput="onFormField" />
          </view>
          <view class="form-group half">
            <text class="form-label">联系电话</text>
            <input class="form-input" value="{{jobForm.contactPhone}}" data-field="contactPhone" bindinput="onFormField" />
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">联系邮箱</text>
          <input class="form-input" value="{{jobForm.contactEmail}}" data-field="contactEmail" bindinput="onFormField" />
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeEditModal">取消</button>
        <button class="btn-confirm" bindtap="submitJob">{{isEdit ? '保存' : '发布'}}</button>
      </view>
    </view>
  </view>
</view>
