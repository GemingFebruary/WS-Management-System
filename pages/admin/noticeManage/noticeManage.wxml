<!--pages/admin/noticeManage/noticeManage.wxml-->
<view class="container">
  <!-- 操作栏 -->
  <view class="action-bar card">
    <view class="action-row">
      <text class="total-text">共 {{noticeList.length}} 条公告</text>
      <button class="btn-create" bindtap="openCreate">+ 发布公告</button>
    </view>
  </view>

  <!-- 公告列表 -->
  <view class="notice-list">
    <block wx:for="{{noticeList}}" wx:key="_id">
      <view class="notice-card card">
        <view class="notice-top">
          <text class="notice-title">{{item.title}}</text>
          <text class="notice-date">{{item.publishDateText}}</text>
        </view>
        <text class="notice-content">{{item.content}}</text>
        <text class="notice-publisher" wx:if="{{item.publisher}}">发布者: {{item.publisher}}</text>
        <view class="notice-actions">
          <button class="btn-action btn-edit" bindtap="openEdit" data-idx="{{index}}">编辑</button>
          <button class="btn-action btn-delete" bindtap="deleteNotice" data-idx="{{index}}">删除</button>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:if="{{noticeList.length === 0 && !loading}}">
      <image class="empty-icon" src="/images/icon/empty-box.png" mode="aspectFit"></image>
      <text class="empty-text">暂无公告</text>
    </view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal">
    <view class="modal-box" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{isEdit ? '编辑公告' : '发布公告'}}</text>
        <text class="modal-close" bindtap="closeEditModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">公告标题</text>
          <input class="form-input" placeholder="请输入公告标题" value="{{editForm.title}}" bindinput="onTitleInput" />
        </view>
        <view class="form-group">
          <text class="form-label">公告内容</text>
          <textarea class="form-textarea" placeholder="请输入公告内容" value="{{editForm.content}}" bindinput="onContentInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeEditModal">取消</button>
        <button class="btn-confirm" bindtap="submitNotice">{{isEdit ? '保存' : '发布'}}</button>
      </view>
    </view>
  </view>
</view>
<toast id="globalToast" />
