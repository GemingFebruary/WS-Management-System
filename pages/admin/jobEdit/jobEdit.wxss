/* pages/admin/jobEdit/jobEdit.wxss */
.card { padding: 8rpx 24rpx; }
.form-row { display: flex; }
.form-group { margin-bottom: 24rpx; flex: 1; }
.form-group.half { flex: 1; margin-right: 16rpx; }
.form-group.half:last-child { margin-right: 0; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 10rpx; }
.form-input { width: 100%; height: 76rpx; line-height: 76rpx; padding: 0 20rpx; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 28rpx; color: var(--color-text); box-sizing: border-box; }
.form-textarea { width: 100%; height: 140rpx; padding: 16rpx 20rpx; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 28rpx; box-sizing: border-box; }
.tag-list { display: flex; flex-wrap: wrap; margin-bottom: 12rpx; }
.tag { display: inline-flex; align-items: center; background: var(--color-primary-light); border-radius: 24rpx; padding: 10rpx 20rpx; margin: 0 16rpx 16rpx 0; }
.tag-text { font-size: 26rpx; color: var(--color-primary-dark); }
.add-btn { display: inline-block; font-size: 26rpx; color: var(--color-primary); background: var(--color-primary-light); border-radius: var(--radius-sm); padding: 14rpx 28rpx; }
.skill-tag { display: inline-block; padding: 14rpx 28rpx; margin: 0 16rpx 16rpx 0; border-radius: 24rpx; font-size: 26rpx; background: var(--color-bg); color: var(--color-text-secondary); }
.skill-tag.active { background: var(--color-primary-light); color: var(--color-primary); }
.save-btn { margin: 16rpx 24rpx; }
