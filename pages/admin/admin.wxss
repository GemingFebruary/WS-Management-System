/* pages/admin/admin.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 管理员头部 */
.admin-header {
  margin: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #fa8c16, #d46b08);
  color: #ffffff;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.admin-name {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 5rpx;
}

.admin-role {
  font-size: 24rpx;
  opacity: 0.7;
}

/* 统计区域 */
.stats-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  padding: 25rpx;
  display: flex;
  align-items: center;
}

.stat-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 15rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.stat-value.pending {
  color: #ff4d4f;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 5rpx;
}

/* 菜单区域 */
.menu-section {
  padding: 0 20rpx;
}

.menu-group {
  margin-bottom: 20rpx;
  padding: 0;
}

.menu-title {
  padding: 20rpx 20rpx 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 15rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
}

.menu-badge {
  background-color: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #cccccc;
}
