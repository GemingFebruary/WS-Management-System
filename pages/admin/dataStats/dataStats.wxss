/* pages/admin/dataStats/dataStats.wxss */
.stat-cards { display: flex; flex-wrap: wrap; }
.stat-card { width: 48%; box-sizing: border-box; padding: 24rpx; margin: 1%; text-align: center; }
.stat-value { display: block; font-size: 40rpx; font-weight: 700; color: var(--color-primary); }
.stat-label { display: block; font-size: 24rpx; color: var(--color-text-secondary); margin-top: 8rpx; }
.chart-card { padding: 24rpx; margin-top: 20rpx; }
.chart-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
