/* pages/admin/matchSettings/matchSettings.wxss */
.tip { padding: 24rpx; margin-bottom: 20rpx; }
.tip-title { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 8rpx; }
.tip-desc { display: block; font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.6; }
.form-card { padding: 8rpx 24rpx; }
.form-item { padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); }
.form-item:last-child { border-bottom: none; }
.form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.form-label { font-size: 28rpx; color: var(--color-text); font-weight: 500; }
.form-value { font-size: 32rpx; color: var(--color-primary); font-weight: 600; }
.form-desc { display: block; font-size: 22rpx; color: var(--color-text-hint); margin-top: 8rpx; }
.save-btn { margin: 32rpx 24rpx; }
