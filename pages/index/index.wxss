/* pages/index/index.wxss */

.container {
  padding-bottom: 20rpx;
}

/* 轮播图样式 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 快捷入口 */
.quick-entry {
  margin: 20rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.entry-list {
  display: flex;
  justify-content: space-around;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.entry-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #666666;
}

/* 推荐岗位区域 */
.recommend-section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #4A90E2;
}

.job-list {
  padding: 0 20rpx;
}

.job-card {
  margin-bottom: 20rpx;
}

.job-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.job-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.match-tag {
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.job-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666666;
}

.salary {
  color: #ff6b35;
  font-weight: bold;
}

.job-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.recruit-num {
  font-size: 24rpx;
  color: #999999;
}

.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.status-recruiting {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-full {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.status-closed {
  background-color: #f5f5f5;
  color: #999999;
}

/* 公告栏 */
.notice-section {
  margin-top: 20rpx;
}

.notice-list {
  padding-top: 10rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-dot {
  color: #4A90E2;
  font-size: 28rpx;
  margin-right: 10rpx;
}

.notice-content {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
}

.notice-date {
  font-size: 22rpx;
  color: #999999;
  margin-left: 20rpx;
}
