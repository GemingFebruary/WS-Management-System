/* pages/jobList/jobList.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  margin: 20rpx;
  padding: 20rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

.search-btn {
  font-size: 28rpx;
  color: #4A90E2;
  padding-left: 20rpx;
}

/* 筛选栏 */
.filter-bar {
  margin: 0 20rpx 20rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-around;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 10rpx 15rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 5rpx;
}

.filter-arrow {
  font-size: 20rpx;
  color: #999999;
}

/* 排序栏 */
.sort-bar {
  margin: 0 20rpx 20rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sort-text {
  font-size: 26rpx;
  color: #999999;
}

.sort-options {
  display: flex;
  gap: 30rpx;
}

.sort-option {
  font-size: 26rpx;
  color: #666666;
  padding: 5rpx 10rpx;
}

.sort-option.active {
  color: #4A90E2;
  border-bottom: 2rpx solid #4A90E2;
}

/* 岗位列表 */
.job-list-container {
  padding: 0 20rpx;
}

.job-card {
  margin-bottom: 20rpx;
  padding: 25rpx;
}

.job-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.job-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.match-tag {
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.job-dept {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.job-details {
  padding: 15rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-item {
  font-size: 24rpx;
  color: #666666;
}

.salary-text {
  color: #ff6b35;
  font-weight: bold;
  font-size: 28rpx;
}

.job-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15rpx;
}

.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.status-recruiting {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-full {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.status-closed {
  background-color: #f5f5f5;
  color: #999999;
}

.publish-date {
  font-size: 22rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-text {
  font-size: 26rpx;
  color: #999999;
}

.no-more-text {
  font-size: 24rpx;
  color: #cccccc;
}
