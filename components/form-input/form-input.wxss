/* components/form-input/form-input.wxss */
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 10rpx; }
.required { color: var(--color-danger); }
.form-input { width: 100%; height: 76rpx; line-height: 76rpx; padding: 0 20rpx; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 28rpx; color: var(--color-text); box-sizing: border-box; border: 1rpx solid transparent; }
.form-input.has-error { border-color: var(--color-danger); }
.form-error { display: block; font-size: 22rpx; color: var(--color-danger); margin-top: 8rpx; }
