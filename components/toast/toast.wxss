/* components/toast/toast.wxss */
.toast-wrap { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 2000; pointer-events: none; }
.toast { max-width: 70%; padding: 24rpx 40rpx; border-radius: var(--radius-md); background: rgba(0,0,0,.82); color: #fff; font-size: 28rpx; line-height: 1.5; text-align: center; animation: toast-in .2s ease; }
.toast.success { background: rgba(82,196,26,.92); }
.toast.error { background: rgba(255,77,79,.92); }
@keyframes toast-in { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }
