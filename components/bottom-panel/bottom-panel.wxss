/* components/bottom-panel/bottom-panel.wxss */
.bp-mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 1100; display: flex; align-items: flex-end; }
.bp-panel { width: 100%; max-height: 78vh; background: var(--color-bg-white); border-radius: var(--radius-md) var(--radius-md) 0 0; display: flex; flex-direction: column; overflow: hidden; animation: bp-up .22s ease; }
@keyframes bp-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
.bp-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--color-border); }
.bp-title { font-size: 30rpx; font-weight: 600; color: var(--color-text); }
.bp-close { font-size: 36rpx; color: var(--color-text-hint); padding: 0 8rpx; }
.bp-body { padding: 24rpx 32rpx; flex: 1; }
.bp-footer { padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--color-border); }
.bp-btn { background: var(--color-primary); color: #fff; font-size: 30rpx; border-radius: var(--radius-sm); }
