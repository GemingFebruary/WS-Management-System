# 微信云开发配置
WX_CLOUD_ENV_ID=your-cloud-env-id
WX_CLOUD_APPID=your-appid
WX_CLOUD_SECRET=your-secret

# MongoDB配置（如果使用本地数据库）
MONGODB_URI=mongodb://localhost:27017/qinggong

# JWT密钥
JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRE_DAYS=7

# Flask配置
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# 允许的前端域名（CORS）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
