# Flask应用环境配置

# 运行环境: development, production, testing
FLASK_ENV=development

# 调试模式
FLASK_DEBUG=True

# 服务器端口
PORT=5000

# MongoDB连接URI
# 本地MongoDB
MONGODB_URI=mongodb://localhost:27017/qinggong

# JWT密钥(生产环境请修改为强密码)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# JWT过期时间(天)
JWT_EXPIRATION_DAYS=7

# 允许跨域的源（开发环境常见端口都加入，避免端口漂移导致CORS失败）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# 微信云开发配置
WX_CLOUD_ENV_ID=
WX_APPID=
WX_SECRET=

# 管理员账号(可选,用于初始化)
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123
